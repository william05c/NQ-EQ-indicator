//@version=5
// ============================================================================
//  Daily Range Forecaster - NQ / ES / Index
// ----------------------------------------------------------------------------
//  Forecasts where today's HIGH and LOW are likely to sit, as calibrated
//  probability bands, using only the chart's own daily bars.
//
//  Method: two log-linear models predict the upside and downside excursions
//  from the session open. Bands come from the empirical quantiles of the
//  model's own recent errors, recomputed every N bars - so they adapt to the
//  current volatility regime without any external data.
//
//  Coefficients were fitted offline on:
//     NQ futures   2018-04 .. 2026-10  (24h Globex sessions)
//     ES futures   2016-10 .. 2026-10  (24h Globex sessions)
//     Cash index   2002-01 .. 2026-10  (RTH)
//  Accuracy is insensitive to the training window (24y and 10y fits score
//  identically), so static coefficients are safe. The bands are NOT static.
//
//  Use on a DAILY chart. On intraday timeframes the features are wrong.
//
//  Honest expectations, out-of-sample 2016-2026:
//     median error on the high ~0.3% of price, on the low ~0.3%
//     an 80% band really does contain the high ~80% of the time
//  It does not predict direction and cannot call the exact high.
// ============================================================================

indicator("Daily Range Forecaster - NQ / ES / Index", "RangeFcst", overlay = true, max_bars_back = 3000)

// ---------------- inputs ----------------
profileIn = input.string("Auto (by symbol)", "Asset profile", options = ["Auto (by symbol)", "NQ futures (24h)", "ES futures (24h)", "Cash index (RTH)"], group = "Model")
residWin  = input.int(500, "Residual window (bars)", minval = 100, maxval = 2000, group = "Model")
minResid  = input.int(60, "Minimum residuals before bands", minval = 20, maxval = 300, group = "Model")
refitN    = input.int(21, "Recompute quantiles every N bars", minval = 1, maxval = 120, group = "Model")
showBands = input.bool(true, "Plot bands", group = "Display")
showTable = input.bool(true, "Show live stats table", group = "Display")
showMeds  = input.bool(true, "Plot median lines", group = "Display")
hiCol     = input.color(color.new(color.teal, 20), "Upside colour", group = "Display")
loCol     = input.color(color.new(color.maroon, 20), "Downside colour", group = "Display")
showNext  = input.bool(true, "Project next session to the right", group = "Projection")
nextBars  = input.int(2, "Projection width (bars)", minval = 1, maxval = 10, group = "Projection")

// ---------------- profile ----------------
autoProf = str.contains(syminfo.ticker, "NQ") ? "NQ" : str.contains(syminfo.ticker, "ES") ? "ES" : "IXIC"
prof = profileIn == "NQ futures (24h)" ? "NQ" : profileIn == "ES futures (24h)" ? "ES" : profileIn == "Cash index (RTH)" ? "IXIC" : autoProf

// upside model: y = ln((high - open) / open)
c0u = prof == "NQ" ? -1.694495 : prof == "ES" ? -1.460724 : -1.560655
c1u = prof == "NQ" ?  0.755239 : prof == "ES" ?  0.681027 :  0.757907
c2u = prof == "NQ" ? -0.125094 : prof == "ES" ?  0.497639 :  0.147927
c3u = prof == "NQ" ?  0.262881 : prof == "ES" ?  0.180519 :  0.073320
c4u = prof == "NQ" ? -0.034915 : prof == "ES" ? -0.399594 : -0.053215

// downside model: y = ln((open - low) / open)
c0d = prof == "NQ" ? -1.692194 : prof == "ES" ? -1.449274 : -1.561902
c1d = prof == "NQ" ?  0.571979 : prof == "ES" ?  0.532104 :  0.495297
c2d = prof == "NQ" ?  0.075713 : prof == "ES" ?  0.621457 :  0.145741
c3d = prof == "NQ" ?  0.067209 : prof == "ES" ?  0.162186 :  0.180904
c4d = prof == "NQ" ?  0.153190 : prof == "ES" ? -0.335095 :  0.101781

// seed residual quantiles (fallback until enough history accumulates)
sU10 = prof == "NQ" ? -1.393331 : prof == "ES" ? -1.478340 : -1.737729
sU50 = prof == "NQ" ?  0.244323 : prof == "ES" ?  0.200374 :  0.297207
sU90 = prof == "NQ" ?  1.137000 : prof == "ES" ?  1.202514 :  1.274199
sD10 = prof == "NQ" ? -1.743627 : prof == "ES" ? -1.798963 : -2.018891
sD50 = prof == "NQ" ?  0.274472 : prof == "ES" ?  0.234755 :  0.299511
sD90 = prof == "NQ" ?  1.427955 : prof == "ES" ?  1.412328 :  1.451093

// ---------------- features (all from data before this bar) ----------------
rr   = (high - low) / close
lr   = nz(close[1], 0.0) > 0 and close > 0 ? math.log(close / close[1]) : 0.0
// Clamp inputs: continuous futures contain roll artefacts and bad ticks. One bar
// with a 1000% "range" would drive mu positive and produce 2-3x multipliers and
// negative low bands, wrecking the chart's price scale.
rrS  = math.min(math.max(rr, 0.0), 0.5)
rr5  = nz(ta.sma(rrS, 5)[1],  rrS)
rr20 = nz(ta.sma(rrS, 20)[1], rrS)
rr60 = nz(ta.sma(rrS, 60)[1], rrS)
rvRaw = nz(ta.stdev(lr, 20, false)[1], nz(ta.stdev(lr, 20, false), 0.01))
rv20 = math.min(math.max(rvRaw, 0.0001), 0.5)

x1 = math.log(rr5 + 0.0001)
x2 = math.log(rr20 + 0.0001)
x3 = math.log(rr60 + 0.0001)
x4 = math.log(rv20 + 0.0001)

muU = c0u + c1u * x1 + c2u * x2 + c3u * x3 + c4u * x4
muD = c0d + c1d * x1 + c2d * x2 + c3d * x3 + c4d * x4

// Hard cap on any excursion. Real daily ranges top out near 14%, so 25% can only
// ever fire on corrupt data - it keeps bands positive and the price scale sane.
capExc(x) =>
    math.min(math.max(math.exp(math.min(x, 0.69)), 0.0), 0.25)

// ---------------- features for the NEXT session ----------------
// These must be evaluated on EVERY bar. Calling ta.* inside the `if barstate.islast`
// block below would break the moving averages (Pine only updates their internal
// state on bars where the branch executes), so they live at global scope.
// They include the current bar - correct for forecasting t+1, unlike muU/muD above
// which are shifted one bar back to avoid lookahead when scoring bar t.
rr5n  = nz(ta.sma(rrS, 5),  rrS)
rr20n = nz(ta.sma(rrS, 20), rrS)
rr60n = nz(ta.sma(rrS, 60), rrS)
rv20n = math.min(math.max(nz(ta.stdev(lr, 20, false), 0.01), 0.0001), 0.5)
n1 = math.log(rr5n + 0.0001)
n2 = math.log(rr20n + 0.0001)
n3 = math.log(rr60n + 0.0001)
n4 = math.log(rv20n + 0.0001)
muUn = c0u + c1u * n1 + c2u * n2 + c3u * n3 + c4u * n4
muDn = c0d + c1d * n1 + c2d * n2 + c3d * n3 + c4d * n4

// ---------------- residual store ----------------
var resU = array.new_float()
var resD = array.new_float()

pct(arr, p) =>
    int n = array.size(arr)
    float r = na
    if n > 0
        s = array.copy(arr)
        array.sort(s, order.ascending)
        int idx = int(math.max(0, math.min(n - 1, math.round(p * (n - 1)))))
        r := array.get(s, idx)
    r

var float qU10 = sU10
var float qU50 = sU50
var float qU90 = sU90
var float qD10 = sD10
var float qD50 = sD50
var float qD90 = sD90
var int   lastQ = -100000

validBands = array.size(resU) >= minResid

if validBands and (bar_index - lastQ >= refitN)
    qU10 := pct(resU, 0.10)
    qU50 := pct(resU, 0.50)
    qU90 := pct(resU, 0.90)
    qD10 := pct(resD, 0.10)
    qD50 := pct(resD, 0.50)
    qD90 := pct(resD, 0.90)
    lastQ := bar_index

// ---------------- bands ----------------
op = open
hiP10 = op * (1.0 + capExc(muU + qU10))
hiP50 = op * (1.0 + capExc(muU + qU50))
hiP90 = op * (1.0 + capExc(muU + qU90))
loP10 = op * (1.0 - capExc(muD + qD90))
loP50 = op * (1.0 - capExc(muD + qD50))
loP90 = op * (1.0 - capExc(muD + qD10))

// ---------------- residual accumulation ----------------
// MUST run on every bar. This is what keeps the bands alive: without it the
// residual arrays stay empty, validBands never becomes true, and every plot
// evaluates to na (the indicator loads but draws nothing).
uRaw = math.min(math.max((high - open) / open, 0.0001), 0.5)
dRaw = math.min(math.max((open - low) / open, 0.0001), 0.5)
array.push(resU, math.log(uRaw) - muU)
array.push(resD, math.log(dRaw) - muD)
if array.size(resU) > residWin
    array.shift(resU)
if array.size(resD) > residWin
    array.shift(resD)

// ---------------- plots ----------------
pHi90 = plot(showBands and validBands ? hiP90 : na, "High p90", color = hiCol, linewidth = 1)
pHi10 = plot(showBands and validBands ? hiP10 : na, "High p10", color = hiCol, linewidth = 1)
pLo10 = plot(showBands and validBands ? loP10 : na, "Low p10",  color = loCol, linewidth = 1)
pLo90 = plot(showBands and validBands ? loP90 : na, "Low p90",  color = loCol, linewidth = 1)
fill(pHi90, pHi10, color = color.new(hiCol, 88), title = "Upside 80% band")
fill(pLo10, pLo90, color = color.new(loCol, 88), title = "Downside 80% band")

plot(showBands and showMeds and validBands ? hiP50 : na, "High median", color = hiCol, linewidth = 2, style = plot.style_line)
plot(showBands and showMeds and validBands ? loP50 : na, "Low median",  color = loCol, linewidth = 2, style = plot.style_line)

// ---------------- live calibration stats ----------------
var int   nStat  = 0
var int   hitH   = 0
var int   hitL   = 0
var float errH   = 0.0
var float errL   = 0.0

if validBands and barstate.isconfirmed
    nStat += 1
    hitH  += (high >= hiP10 and high <= hiP90) ? 1 : 0
    hitL  += (low  >= loP10 and low  <= loP90) ? 1 : 0
    errH  += math.abs(hiP50 - high) / op
    errL  += math.abs(loP50 - low)  / op

// ---------------- table ----------------
var table t = table.new(position.top_right, 2, 6, border_width = 1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "Range forecast", bgcolor = color.new(color.gray, 85), text_color = color.black)
    table.cell(t, 1, 0, prof, bgcolor = color.new(color.gray, 85), text_color = color.black)
    table.cell(t, 0, 1, "Sessions scored", text_color = color.black)
    table.cell(t, 1, 1, str.tostring(nStat), text_color = color.black)
    table.cell(t, 0, 2, "High inside 80%", text_color = color.black)
    table.cell(t, 1, 2, nStat > 0 ? str.tostring(hitH * 100.0 / nStat, "#.0") + "%" : "n/a", text_color = color.black)
    table.cell(t, 0, 3, "Low inside 80%", text_color = color.black)
    table.cell(t, 1, 3, nStat > 0 ? str.tostring(hitL * 100.0 / nStat, "#.0") + "%" : "n/a", text_color = color.black)
    table.cell(t, 0, 4, "Median error high", text_color = color.black)
    table.cell(t, 1, 4, nStat > 0 ? str.tostring(errH / nStat * 100, "#.##") + "%" : "n/a", text_color = color.black)
    table.cell(t, 0, 5, "Median error low", text_color = color.black)
    table.cell(t, 1, 5, nStat > 0 ? str.tostring(errL / nStat * 100, "#.##") + "%" : "n/a", text_color = color.black)

// ---------------- alerts ----------------
alertcondition(validBands and high > hiP90, "High above p90 band", "Range expansion: high exceeded the p90 forecast band")
alertcondition(validBands and low < loP10, "Low below p10 band", "Range expansion: low broke the p10 forecast band")

// ---------------- next-session projection ----------------
// The model forecasts a session's extremes FROM THAT SESSION'S OPEN, so a
// historical band cannot be projected forward: tomorrow's band does not exist
// until tomorrow opens. What follows is a visual guide only, anchored at the
// last close, showing where the NEXT session's range is likely to sit.
// It ignores the overnight gap, so treat it as indicative, not exact.
var box  projEnv   = na
var box  projHiBox = na
var box  projLoBox = na
var line projHiMed = na
var line projLoMed = na

if barstate.islast and showNext and showBands and validBands
    anchor = close
    nh10 = anchor * (1.0 + capExc(muUn + qU10))
    nh50 = anchor * (1.0 + capExc(muUn + qU50))
    nh90 = anchor * (1.0 + capExc(muUn + qU90))
    nl10 = anchor * (1.0 - capExc(muDn + qD90))
    nl50 = anchor * (1.0 - capExc(muDn + qD50))
    nl90 = anchor * (1.0 - capExc(muDn + qD10))
    xL = bar_index + 1
    xR = bar_index + 1 + nextBars
    if not na(projEnv)
        box.delete(projEnv)
        box.delete(projHiBox)
        box.delete(projLoBox)
        line.delete(projHiMed)
        line.delete(projLoMed)
    // full envelope first, then the two sub-bands on top
    projEnv := box.new(xL, nh90, xR, nl10, bgcolor = color.new(color.gray, 93), border_color = color.new(color.gray, 75))
    projHiBox := box.new(xL, nh90, xR, nh10, bgcolor = color.new(hiCol, 82), border_color = color.new(hiCol, 45))
    projLoBox := box.new(xL, nl90, xR, nl10, bgcolor = color.new(loCol, 82), border_color = color.new(loCol, 45))
    projHiMed := line.new(xL, nh50, xR, nh50, color = hiCol, width = 2, style = line.style_dashed)
    projLoMed := line.new(xL, nl50, xR, nl50, color = loCol, width = 2, style = line.style_dashed)


