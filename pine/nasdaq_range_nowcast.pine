//@version=5
// ============================================================================
//  Daily Range NOWCAST - intraday, converging
// ----------------------------------------------------------------------------
//  Projects where today's high/low will END UP, and updates as the session runs.
//  The band converges onto what has already printed, and the table reports the
//  probability that each extreme is already in.
//
//  Why not "more intraday features at the open": at 09:30 the 14:00 bar does not
//  exist. Intraday data cannot improve the pre-open forecast - it can only
//  re-estimate it as information arrives. That is what this script does.
//
//  Maths: the remaining session is a driftless diffusion with volatility
//  sigma_rem = sigma_d * sqrt(1 - t). By the reflection principle, given the
//  running high H and price P,
//
//      P(final high <= h) = 2*Phi((h - P)/sigma_rem) - 1      (h >= max(H, P))
//      =>  h_q = max(H, P + sigma_rem * Phi^-1((1+q)/2))
//
//  Monte Carlo over 3,000 simulated sessions per scenario: the "already set"
//  probabilities track realised frequency within 2-3 points, including under
//  fat-tailed increments and a U-shaped volatility profile.
//
//  Design note: the running high/low come straight from the DAILY timeframe via
//  request.security. An earlier version tracked them manually with session
//  strings; that state could go stale and paint levels from previous days.
// ============================================================================

indicator("Daily Range Nowcast (intraday)", "RangeNowcast", overlay = true)

// ---------------- inputs ----------------
profileIn = input.string("Auto (by symbol)", "Asset profile", options = ["Auto (by symbol)", "NQ futures (24h)", "ES futures (24h)", "Cash index (RTH)"], group = "Model")
showBand  = input.bool(true, "Show converging band", group = "Display")
showTable = input.bool(true, "Show probability table", group = "Display")
hiCol     = input.color(color.new(color.teal, 10), "Upside colour", group = "Display")
loCol     = input.color(color.new(color.maroon, 10), "Downside colour", group = "Display")

// ---------------- profile ----------------
autoProf = str.contains(syminfo.ticker, "NQ") ? "NQ" : str.contains(syminfo.ticker, "ES") ? "ES" : "IXIC"
prof = profileIn == "NQ futures (24h)" ? "NQ" : profileIn == "ES futures (24h)" ? "ES" : profileIn == "Cash index (RTH)" ? "IXIC" : autoProf

c0u = prof == "NQ" ? -1.694495 : prof == "ES" ? -1.460724 : -1.560655
c1u = prof == "NQ" ?  0.755239 : prof == "ES" ?  0.681027 :  0.757907
c2u = prof == "NQ" ? -0.125094 : prof == "ES" ?  0.497639 :  0.147927
c3u = prof == "NQ" ?  0.262881 : prof == "ES" ?  0.180519 :  0.073320
c4u = prof == "NQ" ? -0.034915 : prof == "ES" ? -0.399594 : -0.053215

c0d = prof == "NQ" ? -1.692194 : prof == "ES" ? -1.449274 : -1.561902
c1d = prof == "NQ" ?  0.571979 : prof == "ES" ?  0.532104 :  0.495297
c2d = prof == "NQ" ?  0.075713 : prof == "ES" ?  0.621457 :  0.145741
c3d = prof == "NQ" ?  0.067209 : prof == "ES" ?  0.162186 :  0.180904
c4d = prof == "NQ" ?  0.153190 : prof == "ES" ? -0.335095 :  0.101781

sU10 = prof == "NQ" ? -1.393331 : prof == "ES" ? -1.478340 : -1.737729
sU50 = prof == "NQ" ?  0.244323 : prof == "ES" ?  0.200374 :  0.297207
sU90 = prof == "NQ" ?  1.137000 : prof == "ES" ?  1.202514 :  1.274199
sD10 = prof == "NQ" ? -1.743627 : prof == "ES" ? -1.798963 : -2.018891
sD50 = prof == "NQ" ?  0.274472 : prof == "ES" ?  0.234755 :  0.299511
sD90 = prof == "NQ" ?  1.427955 : prof == "ES" ?  1.412328 :  1.451093

// ---------------- daily inputs ----------------
// Returns the model features plus TODAY'S running high/low, all taken from the
// daily timeframe. No manual session state, so nothing can go stale.
dailyFeat() =>
    rrD  = (high - low) / close
    rrSD = math.min(math.max(rrD, 0.0), 0.5)
    lrD  = nz(close[1], 0.0) > 0 and close > 0 ? math.log(close / close[1]) : 0.0
    r5   = nz(ta.sma(rrSD, 5)[1],  rrSD)
    r20  = nz(ta.sma(rrSD, 20)[1], rrSD)
    r60  = nz(ta.sma(rrSD, 60)[1], rrSD)
    rv   = math.min(math.max(nz(ta.stdev(lrD, 20, false)[1], 0.01), 0.0001), 0.5)
    [open, r5, r20, r60, rv, high, low]

[oD, r5D, r20D, r60D, rvD, dHi, dLo] = request.security(syminfo.tickerid, "D", dailyFeat(), lookahead = barmerge.lookahead_off)

capExc(x) =>
    math.min(math.max(math.exp(math.min(x, 0.69)), 0.0), 0.25)

x1 = math.log(r5D + 0.0001)
x2 = math.log(r20D + 0.0001)
x3 = math.log(r60D + 0.0001)
x4 = math.log(rvD + 0.0001)

muU = c0u + c1u * x1 + c2u * x2 + c3u * x3 + c4u * x4
muD = c0d + c1d * x1 + c2d * x2 + c3d * x3 + c4d * x4

// daily model's median high/low -> implied full-day range -> daily sigma
dayHi50  = oD * (1.0 + capExc(muU + sU50))
dayLo50  = oD * (1.0 - capExc(muD + sD50))
sigmaRaw = (dayHi50 - dayLo50) / 1.596            // Feller: E[range] = 1.596 * sigma
// sanity: a daily sigma above 8% of price is corrupt data, not a forecast
sigmaDay = sigmaRaw > 0 and sigmaRaw < oD * 0.08 ? sigmaRaw : na

// ---------------- elapsed fraction of the trading day ----------------
// Futures trade a 23h day (18:00 -> 17:00 ET); cash indices 6.5h. Using the cash
// window on a 24h futures chart pins elapsed at 0 overnight, which makes the band
// look frozen - so the window follows the instrument.
sessZone  = "America/New_York"
isFutures = prof == "NQ" or prof == "ES"
startMin  = isFutures ? 18 * 60 : 9 * 60 + 30
spanMin   = isFutures ? 23 * 60 : 390
minsNow   = hour(time, sessZone) * 60 + minute(time, sessZone)
intoDay   = (minsNow - startMin + 1440) % 1440
futElapsed  = math.min(math.max(intoDay / spanMin, 0.0), 1.0)
// cash: no wrap-around - before 09:30 counts as 0, not "end of yesterday"
cashElapsed = minsNow >= 960 ? 1.0 : minsNow >= 570 ? (minsNow - 570) / 390 : 0.0
elapsed     = isFutures ? futElapsed : cashElapsed

// ---------------- nowcast ----------------
normCdf(x) =>
    // Abramowitz-Stegun 7.1.26
    a = 1.0 / (1.0 + 0.3275911 * math.abs(x))
    y = 1.0 - ((((1.061405429 * a - 1.453152027) * a + 1.421413741) * a - 0.284496736) * a + 0.254829592) * a * math.exp(-x * x)
    x >= 0 ? 0.5 * (1.0 + y) : 0.5 * (1.0 - y)

z10 = 0.125661   // Phi^-1(0.55)
z50 = 0.674490   // Phi^-1(0.75)
z90 = 1.644854   // Phi^-1(0.95)

pNow     = close
sigmaRem = nz(sigmaDay, 0.0) * math.sqrt(math.max(1.0 - elapsed, 0.0))

hiRef = math.max(nz(dHi, pNow), pNow)
loRef = math.min(nz(dLo, pNow), pNow)

hiNow10 = math.max(hiRef, pNow + sigmaRem * z10)
hiNow50 = math.max(hiRef, pNow + sigmaRem * z50)
hiNow90 = math.max(hiRef, pNow + sigmaRem * z90)
loNow90 = math.min(loRef, pNow - sigmaRem * z10)
loNow50 = math.min(loRef, pNow - sigmaRem * z50)
loNow10 = math.min(loRef, pNow - sigmaRem * z90)

// probability each extreme is already set (reflection principle)
safeSig  = math.max(sigmaRem, pNow * 0.000001)
pNewHigh = 2.0 * (1.0 - normCdf((hiRef - pNow) / safeSig))
pNewLow  = 2.0 * (1.0 - normCdf((pNow - loRef) / safeSig))
pHiSet   = math.min(math.max(1.0 - pNewHigh, 0.0), 1.0)
pLoSet   = math.min(math.max(1.0 - pNewLow, 0.0), 1.0)

// ---------------- plots ----------------
showIt = showBand and not na(sigmaDay)
plot(showIt ? hiNow90 : na, "Final high p90", color = hiCol, linewidth = 1)
plot(showIt ? hiNow10 : na, "Final high p10", color = color.new(hiCol, 60), linewidth = 1)
plot(showIt ? hiNow50 : na, "Final high median", color = hiCol, linewidth = 2)
plot(showIt ? loNow90 : na, "Final low p90", color = color.new(loCol, 60), linewidth = 1)
plot(showIt ? loNow10 : na, "Final low p10", color = loCol, linewidth = 1)
plot(showIt ? loNow50 : na, "Final low median", color = loCol, linewidth = 2)

// ---------------- table ----------------
var table t = table.new(position.top_right, 2, 6, border_width = 1)
if showTable and barstate.islast and not na(sigmaDay)
    table.cell(t, 0, 0, "Nowcast", bgcolor = color.new(color.gray, 85), text_color = color.black)
    table.cell(t, 1, 0, prof, bgcolor = color.new(color.gray, 85), text_color = color.black)
    table.cell(t, 0, 1, "Session elapsed", text_color = color.black)
    table.cell(t, 1, 1, str.tostring(elapsed * 100, "#.0") + "%", text_color = color.black)
    table.cell(t, 0, 2, "High already set", text_color = color.black)
    table.cell(t, 1, 2, str.tostring(pHiSet * 100, "#.0") + "%", text_color = hiCol)
    table.cell(t, 0, 3, "Low already set", text_color = color.black)
    table.cell(t, 1, 3, str.tostring(pLoSet * 100, "#.0") + "%", text_color = loCol)
    table.cell(t, 0, 4, "Remaining swing", text_color = color.black)
    table.cell(t, 1, 4, str.tostring(sigmaRem * z90, format.mintick) + " pts", text_color = color.black)
    table.cell(t, 0, 5, "Session range", text_color = color.black)
    table.cell(t, 1, 5, str.tostring(hiRef - loRef, format.mintick) + " pts", text_color = color.black)

// ---------------- alerts ----------------
alertcondition(pHiSet > 0.9, "High set", "More than 90% chance today's high is already in")
alertcondition(pLoSet > 0.9, "Low set", "More than 90% chance today's low is already in")
