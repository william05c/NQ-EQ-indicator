{
  "name": "nasdaq-range-forecaster",
  "version": "1.0.0",
  "description": "Calibrated daily high/low prediction bands for NQ, ES and the Nasdaq Composite, with walk-forward validation and a TradingView indicator",
  "type": "commonjs",
  "scripts": {
    "data": "node src/build_all_datasets.js",
    "refresh": "node src/refresh_ixic.js",
    "forecast": "node src/range_forecast.js",
    "benchmark": "node src/benchmark.js",
    "backtest": "node src/backtest_10y.js",
    "compare": "node src/model_compare.js",
    "futures": "node src/nq_es_indicator.js",
    "limits": "node src/accuracy_limits.js",
    "fit": "node src/fit_coefficients.js",
    "rehearse": "node src/pine_rehearsal.js",
    "estimate": "node src/predictability_check.js"
  },
  "keywords": [
    "nasdaq",
    "nq",
    "es",
    "futures",
    "volatility",
    "range-forecast",
    "quantitative-finance",
    "tradingview",
    "pine-script"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}

